---
import BaseLayout from "../layouts/BaseLayout.astro";
import Image from "astro/components/Image.astro";

import "../styles/gallery.css";

import { getCollection } from "astro:content";

const graphics = await getCollection("imgs");
const photos = Object.values(import.meta.glob("@images/original/*.jpg"))
    .map(photo => ({ data: {src: photo(), alt: ''} }));
const allImages = [...graphics, ...photos];
---

<BaseLayout pageTitle="Sitemap">
    <div class="grid">
        {
            allImages.map(({ data }) => (
                <div class="img-wrapper grid__panel" ondragstart="return false">
                    <Image
                        src={data.src}
                        alt={data.alt}
                        class="grid__img"
                        usemap="sitemap-map"
                        id="sitemap"
                    />
                </div>
            ))
        }
        <div class="street">A one-way street is trodden in time</div>
    </div>
</BaseLayout>
