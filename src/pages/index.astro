---
import BaseLayout from "../layouts/BaseLayout.astro";
import Image from "astro/components/Image.astro";
import collage1 from "../assets/images/collages/1st_collage.png";
import collage2 from "../assets/images/collages/2nd_collage.png";
import collage3 from "../assets/images/collages/3rd_collage.png";

import "../styles/index.css"

const collageCaptions = [
	'Melancholy is truly the birth of evil.',
	'We fly in negations.',
	'Interiors and exteriors.',

]

/* Add effect: text fades to black while scrolling */
---

<BaseLayout pageTitle="Beginnings">
	<article class="story">
		<div class="header">
			<!-- <div id="img1" /> -->
			<p class="header__desc">A collage book</p>
			<h1>A Flagrant Myth</h1>
		</div>
		<!-- <img src="../assets/images/collages/1st_collage.png" alt="" /> -->
		<div class="cover-gallery">
			{[collage1, collage2, collage3].map((csrc, i) => (
				<div class="gallery__img hoverable img-wrapper">
					<Image
						src={csrc}
						alt={collageCaptions[i]}
						class="flip-img"
					/>
				</div>
			))}
		</div>
		<div class="para">
			<div>
				<p>Our story starts in the middle, with a disappearance.</p>
				<p>
					A slow decay that pulls brick from brick and the white paint
					peeling from walls like the fingers of a ghost. Shutters
					fall on the shops, houses crumble like dust. People turn
					into creatures half-human, half-goat. They defecate into the
					hollows of blasted trees, they gnaw at the grass that
					springs from ruined walls.
				</p>
				<p>
					As the days pass they are no longer visible; they have
					dissolved into <a href={import.meta.env.BASE_URL + "/poem"}
						>a primeval music...</a>
				</p>
			</div>
		</div>
		<div class="para">
			<div>
				<p class="large">TEN YEARS BEFORE, near the beginning</p>
				<a href={import.meta.env.BASE_URL + "/news_clippings"}
					>News clippings and documents</a
				>
			</div>
		</div>
		<div class="para">
			<div>
				<p class="large">TEN YEARS LATER, near the end</p>
				<a href={import.meta.env.BASE_URL + "/urban_explorer"}
					>Transcript from an unreleased tape made by an urban
					explorer</a
				>
			</div>
		</div>
		<div class="para">
			<div>
				<p class="large">OUT OF CONTEXT</p>
				<a href={import.meta.env.BASE_URL + "/conversation"}
					>A conversation à la Oscar Wilde</a
				>
			</div>
		</div>
	</article>
</BaseLayout>